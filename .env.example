# ── YouTube Shorts Automation — Environment Variables ──
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git.

# Gemini API Key (free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here

# Pexels API Key (free from https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# Pixabay API Key — OPTIONAL, used as fallback when Pexels has no results
# Free from https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Your channel's content niche (used in script generation prompts)
CHANNEL_NICHE=AI and Machine Learning facts

# Edge-TTS voice (see Architecture.md for full list)
VOICE=en-GB-RyanNeural

# Gemini model for script generation
# Default: gemini-2.5-flash (free, 1500 req/day)
# For higher quality: gemini-2.5-pro (requires billing, ~₹0.05/script)
SCRIPT_MODEL=gemini-2.5-flash
